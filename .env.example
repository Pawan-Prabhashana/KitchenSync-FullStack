# ─── KitchenSync API ──────────────────────────────────────────────────────────
# Port the Express API listens on (Vite uses 3000, so keep these separate).
PORT=4000

# Secret used to sign JWTs. REQUIRED in production. In dev, if unset, the server
# falls back to an insecure throwaway secret and warns. Use a long random string.
JWT_SECRET="change-me-to-a-long-random-string"

# How long issued JWTs stay valid (jsonwebtoken format, e.g. 7d, 12h).
JWT_EXPIRES_IN=7d

# Origin allowed by CORS — the Vite dev server.
CORS_ORIGIN=http://localhost:3000

# Base URL the frontend uses to reach the API (Vite reads VITE_* at build time).
VITE_API_URL=http://localhost:4000

# ─── AI Studio (existing) ─────────────────────────────────────────────────────
# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
